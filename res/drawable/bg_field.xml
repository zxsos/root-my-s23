<?xml version="1.0" encoding="utf-8"?>
<!--
  M3 outlined text field：常态 1dp outline，聚焦时 2dp primary。
  纯 XML 做不了浮动 label，所以 label 放在控件上方单独一行
  （M3 里 label 在外的变体，视觉同样成立）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_high" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/md_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_high" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/md_outline_variant" />
        </shape>
    </item>
</selector>
